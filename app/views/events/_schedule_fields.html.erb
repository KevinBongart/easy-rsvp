<fieldset>
  <legend class="form-label fs-6 float-none mb-2">When is this happening?</legend>
  <%= label_tag 'event_date_2i', 'Month', class: 'visually-hidden' %>
  <%= label_tag 'event_date_3i', 'Day', class: 'visually-hidden' %>
  <%= label_tag 'event_date_1i', 'Year', class: 'visually-hidden' %>
  <%= f.input :date,
    required: false,
    label: false,
    order: [:month, :day, :year],
    start_year: Date.current.year %>

  <% schedule_open = f.object.schedule_enabled? %>
  <div class="schedule-disclosure" data-controller="schedule">
    <%= f.check_box :schedule_enabled,
      checked: schedule_open,
      class: 'schedule-toggle visually-hidden',
      aria: { controls: 'event-schedule-fields' },
      data: {
        action: 'change->schedule#toggleSchedule',
        schedule_target: 'enabled'
      } %>
    <%= f.label :schedule_enabled, class: 'schedule-summary link-primary mb-3' do %>
      <span class="schedule-summary-closed">Add a time</span>
      <span class="schedule-summary-open">Nevermind, just the date</span>
    <% end %>
    <div class="schedule-time-fields row g-2" id="event-schedule-fields">
      <div class="col-md-4">
        <%= f.input :start_time,
          as: :string,
          label: 'From',
          required: false,
          error: schedule_time_error(f.object, :start_time),
          input_html: {
            placeholder: '7:00 PM',
            autocomplete: 'off',
            data: {
              action: 'blur->schedule#normalizeTime'
            }
          } %>
      </div>
      <div class="col-md-4">
        <%= f.input :end_time,
          as: :string,
          label: 'To',
          required: false,
          error: schedule_time_error(f.object, :end_time),
          input_html: {
            placeholder: '10:00 PM',
            autocomplete: 'off',
            data: {
              action: 'blur->schedule#normalizeTime'
            }
          } %>
      </div>
      <div class="col-md-4">
        <%= f.input :time_zone,
          as: :string,
          label: 'Time zone',
          required: false,
          input_html: {
            list: 'event-time-zones',
            data: {
              schedule_target: 'timeZone'
            }
          } %>
      </div>
    </div>
    <datalist id="event-time-zones">
      <% time_zone_identifiers.each do |time_zone| %>
        <option value="<%= time_zone %>"></option>
      <% end %>
    </datalist>
  </div>
</fieldset>

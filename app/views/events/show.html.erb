<h1>
  <%= @event.title %>

  <small class='text-muted'>
    //
    <%= @event.date.to_formatted_s(:week_day_and_date) %>
  </small>

</h1>

<%= @event.body %>

<br>

<h2>Who's coming?</h2>

<% unless @event.show_rsvp_names? %>
  <small>Guest names are hidden to other guests.</small>
<% end %>

<div data-controller="reveal">
  <%= form_for [@event, @rsvp], html: { class: "d-flex flex-wrap align-items-center gap-2 #{'d-none' if @responded}", data: { reveal_target: 'content' } } do |f| %>
    <%= f.label :name, "Your name:" %>
    <%= f.text_field :name, class: 'form-control w-auto' %>

    <% Rsvp::RESPONSES.each do |response| %>
      <%= f.submit value: response.to_s.titleize, class: 'btn btn-primary' %>
    <% end %>
  <% end %>

  <% if @responded %>
    <span id='rsvp-again' data-reveal-target="trigger"><%= link_to 'RSVP again', '#', data: { action: 'reveal#show' } %></span>
  <% end %>
</div>

<% Rsvp::RESPONSES.each do |response| %>
  <% rsvps = @rsvps.select { |rsvp| rsvp.response.to_sym == response } %>

  <% if rsvps.any? %>
    <strong><%= response.to_s.titleize %></strong> (<%= rsvps.count %>)

    <ul>
      <% rsvps.each do |rsvp| %>
        <% if @event.show_rsvp_names? %>
          <li>
            <%= rsvp.name %>

            <% if rsvp.hashid.in? @user_rsvp_hashids %>
              <small>
                [<%= link_to 'x', event_rsvp_path(@event, rsvp), data: { turbo_method: :delete } %>]
              </small>
            <% end %>
          </li>
        <% elsif rsvp.hashid.in? @user_rsvp_hashids %>
          <li>
            <%= rsvp.name %>

            <small>
              [<%= link_to 'x', event_rsvp_path(@event, rsvp), data: { turbo_method: :delete } %>]
            </small>
          </li>
        <% end %>
      <% end %>
    </ul>
  <% end %>
<% end %>

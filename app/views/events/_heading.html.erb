<h1 class="event-heading mb-1"><%= event.title %></h1>

<div class="event-metadata mb-3">
  <div class="fs-2 text-muted"><%= event_schedule(event) %></div>

  <% if event.published? %>
    <div class="small mt-1">
      <%= link_to calendar_event_path(event, format: :ics), class: 'calendar-link d-inline-flex align-items-center gap-1' do %>
        <%# Bootstrap Icons calendar-plus, licensed under MIT. %>
        <svg class="bi bi-calendar-plus" width="1em" height="1em" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true" focusable="false">
          <path d="M8 7a.5.5 0 0 1 .5.5V9H10a.5.5 0 0 1 0 1H8.5v1.5a.5.5 0 0 1-1 0V10H6a.5.5 0 0 1 0-1h1.5V7.5A.5.5 0 0 1 8 7" />
          <path d="M3.5 0a.5.5 0 0 1 .5.5V1h8V.5a.5.5 0 0 1 1 0V1h1a2 2 0 0 1 2 2v11a2 2 0 0 1-2 2H2a2 2 0 0 1-2-2V3a2 2 0 0 1 2-2h1V.5a.5.5 0 0 1 .5-.5M1 4v10a1 1 0 0 0 1 1h12a1 1 0 0 0 1-1V4z" />
        </svg>
        <span>Add to calendar</span>
      <% end %>
    </div>
  <% end %>
</div>

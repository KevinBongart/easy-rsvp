<!DOCTYPE html>
<html lang="en">
  <head>
    <title>
      <%= content_for?(:title) ? yield(:title) : (@event&.title || "Easy RSVP") %>
    </title>

    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= stylesheet_link_tag 'application', media: 'all', integrity: true, 'data-turbo-track': 'reload' %>
    <%# esbuild emits an ES module; module scope also prevents bundled helper names from replacing browser globals. %>
    <%= javascript_include_tag 'application', type: 'module', integrity: true, 'data-turbo-track': 'reload' %>

    <%= render 'application/favicon' %>
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
  </head>

  <body>
    <div class="container" id="main">
      <nav class="navbar navbar-light mb-2" aria-label="Main navigation">
        <%= link_to root_path, class: 'navbar-brand' do %>
          <%= image_tag 'logo-small.png', id: 'logo', alt: '' %>
          Easy RSVP
        <% end %>
      </nav>

      <main>
        <%= render 'layouts/messages' %>
        <%= yield %>
      </main>

      <footer class="site-footer text-end mt-5">
        <hr>
        <p class="small">
          Easy RSVP is an
          <a href="https://github.com/KevinBongart/easy-rsvp">open-source</a>
          app made with care by
          <a href="http://kevinbongart.net">Kevin Bongart</a>.
          <a href="https://www.kevinbongart.net/projects/easy-rsvp.html">Learn more</a>.
        </p>
      </footer>
    </div>

  </body>
</html>

<h1>Edit your event</h1>

<%= simple_form_for @event, url: event_admin_path(@event, @event.admin_token) do |f| %>
  <%= f.input :title, error: 'Your event needs a name!' %>

  <fieldset>
    <legend class="form-label fs-6 float-none mb-2">When is this happening?</legend>
    <%= label_tag 'event_date_2i', 'Month', class: 'visually-hidden' %>
    <%= label_tag 'event_date_3i', 'Day', class: 'visually-hidden' %>
    <%= label_tag 'event_date_1i', 'Year', class: 'visually-hidden' %>
    <%= f.input :date,
      label: false,
      order: [:month, :day, :year],
      start_year: Date.today.year
    %>
  </fieldset>


  <%= f.label :body, 'More details (optional):', class: 'form-label mb-2' %>
  <%= f.rich_text_area :body,
    aria: { label: 'More details (optional)' },
    data: {
      controller: 'rich-text',
      action: 'trix-file-accept->rich-text#acceptFile direct-upload:error->rich-text#uploadFailed direct-upload:end->rich-text#uploadFinished'
    }
  %>

  <br>

  <%= f.input :show_rsvp_names, label: 'Let guests see the names of other guests' %>

  <br>

  <%= f.button :submit, class: 'btn-primary me-2' %>
  <%= link_to "Back", event_admin_path(@event, @event.admin_token), class: 'btn-link' %>
<% end %>

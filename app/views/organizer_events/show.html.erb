<%= render 'events/heading', event: @event %>

<p>
  <%= link_to "Edit event", edit_event_admin_path(@event, @event.admin_token), class: 'btn btn-primary' %>
</p>

<ul>
  <li>
    This is your super-secret admin link:
    <%= link_to event_admin_url(@event, @event.admin_token), event_admin_path(@event, @event.admin_token), id: 'admin-link', class: 'event-url' %>.
    Bookmark it!
  </li>

  <li>
    Invite your guests by sending them this link:
    <%= link_to event_url(@event), event_path(@event), id: 'public-link', class: 'event-url' %>

    <span data-controller="clipboard" data-clipboard-text-value="<%= event_url(@event) %>">
      <%= content_tag :button,
        'Copy',
        type: :button,
        class: ['btn', 'btn-sm', 'btn-outline-success', 'clipboard'],
        data: {
          action: 'clipboard#copy',
          clipboard_target: 'button'
        } %>
      <span class="visually-hidden" role="status" aria-live="polite" data-clipboard-target="status"></span>
    </span>

    Everyone with the link can RSVP, no account required.
  </li>

  <li>
    <% if @event.published? %>
      <%= button_to 'Unpublish this event', toggle_publish_event_admin_path(@event, @event.admin_token), class: 'btn btn-link', form_class: 'inline-btn-link' %>.
      No one will be able to view the event page. You can come back to this admin page anytime to change this if needed.
    <% else %>
      <strong>Your event is not publicly viewable right now.</strong> No one is currently able to view the event page.
      <%= button_to 'Publish this event', toggle_publish_event_admin_path(@event, @event.admin_token), class: 'btn btn-link', form_class: 'inline-btn-link' %>.
    <% end %>
  </li>
</ul>

<h2>Details</h2>

<% if @event.body.blank? %>
  <p>
    Where is this event taking place? What should the guests bring?
    <%= link_to "Add some details", edit_event_admin_path(@event, @event.admin_token) %>.
  </p>
<% else %>
  <%= @event.body %>
  <br>
<% end %>

<h2>RSVPs</h2>

<p>
  <% if @event.show_rsvp_names? %>
    Guests can see the names of other guests.
  <% else %>
    Guest names are hidden to other guests.
  <% end %>

  <%= link_to "Edit event", edit_event_admin_path(@event, @event.admin_token) %>
</p>

<ul>
  <% Rsvp::RESPONSES.each do |response| %>
    <% rsvps = @rsvps.select { |rsvp| rsvp.response.to_sym == response } %>

    <li>
      <%= response.to_s.titleize %> (<%= rsvps.count %>)
      <ul>
        <% rsvps.each do |rsvp| %>
          <li>
            <%= rsvp.name %>
            [<%= link_to 'edit', '#', aria: { label: "Edit RSVP for #{rsvp.name}" }, data: { bs_toggle: :modal, bs_target: "#rsvp_#{rsvp.hashid}_modal" } %>]
          </li>
        <% end %>
      </ul>
    </li>
  <% end %>
</ul>

<% @rsvps.each do |rsvp| %>
  <div class='modal fade' id='<%= "rsvp_#{rsvp.hashid}_modal" %>' tabindex='-1' aria-label='<%= "Edit RSVP for #{rsvp.name}" %>' aria-hidden='true'>
    <div class='modal-dialog' role='document'>
      <div class='modal-content'>
        <div class='modal-body'>
          <%= form_for rsvp, namespace: rsvp.hashid, url: event_admin_rsvp_path(@event, @event.admin_token, rsvp) do |f| %>

            <div class='mb-3'>
              <%= f.label :name %>
              <%= f.text_field :name, class: 'form-control' %>
            </div>

            <div class='mb-3'>
              <%= f.label :response %>
              <%= f.select :response, Rsvp::RESPONSES.map { |r| [r.to_s.titleize, r] }, {}, class: 'form-select' %>
            </div>

            <%= f.submit 'Update', class: 'btn btn-primary me-2' %>
            <button type='button' class='btn btn-link' data-bs-dismiss='modal'>Close</button>
            <%= link_to 'Delete…', event_admin_rsvp_path(@event, @event.admin_token, rsvp), class: 'btn btn-danger float-end', data: { turbo_method: :delete, turbo_confirm: 'Are you sure you want to delete this RSVP?' } %>
          <% end %>
        </div>
      </div>
    </div>
  </div>
<% end %>

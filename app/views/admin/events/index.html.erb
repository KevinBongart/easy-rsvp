<% content_for :title, "Events admin · Easy RSVP" %>

<h1>Events admin</h1>

<div class="admin-statistics mb-3">
  <div class="mb-2">
    <strong>Total events created<% if (oldest_date = @event_stats.oldest_creation_date) %> since <%= oldest_date %><% end %>:</strong> <%= @event_stats.total_events %>
  </div>
  <div class="admin-stat-row">
    <span class="admin-stat-label">Yearly <%= @event_stats.now.year %>: <strong><%= @event_stats.current_year_count %> so far</strong>, <%= @event_stats.extrapolated_current_year_count %> extrapolated</span>
    <%= render 'sparkline', id: 'yearly-chart', label: 'Events created by year', series: @event_stats.yearly_chart %>
  </div>
  <div class="admin-stat-row">
    <span class="admin-stat-label">Last <%= @event_stats.months_back %> months</span>
    <%= render 'sparkline', id: 'monthly-chart', label: 'Events created by month', series: @event_stats.monthly_chart %>
  </div>
  <div class="admin-stat-row">
    <span class="admin-stat-label"><%= @event_stats.current_month_label %>: <strong><%= @event_stats.current_month_count %> so far</strong>, <%= @event_stats.extrapolated_current_month_count %> extrapolated</span>
    <%= render 'sparkline', id: 'current-month-chart', label: 'Running total of events created this month', series: @event_stats.current_month_chart %>
  </div>
</div>

<div class="admin-sort mb-2">
  <% if params[:sort].blank? %>
    <strong>Sorted by ID</strong>
  <% else %>
    <%= link_to "Sort by ID", admin_events_path(attachments: params[:attachments].presence, timed: params[:timed].presence) %>
  <% end %>
  <span aria-hidden="true">·</span>
  <% if params[:sort] == "rsvps" %>
    <strong>Sorted by RSVP count</strong>
  <% else %>
    <%= link_to "Sort by RSVP count", admin_events_path(sort: "rsvps", attachments: params[:attachments].presence, timed: params[:timed].presence) %>
  <% end %>
  <span aria-hidden="true">·</span>
  <% if params[:sort] == "attachments" %>
    <strong>Sorted by attachment size</strong>
  <% else %>
    <%= link_to "Sort by attachment size", admin_events_path(sort: "attachments", attachments: params[:attachments].presence, timed: params[:timed].presence) %>
  <% end %>
  <span aria-hidden="true">·</span>
  <% if params[:attachments] == "1" %>
    <%= link_to "Include events without attachments", admin_events_path(sort: params[:sort].presence, timed: params[:timed].presence) %>
  <% else %>
    <%= link_to "Only with attachments", admin_events_path(sort: params[:sort].presence, attachments: "1", timed: params[:timed].presence) %>
  <% end %>
  <span aria-hidden="true">·</span>
  <% if params[:timed] == "1" %>
    <strong>Showing only events with a time</strong>
    <span aria-hidden="true">·</span>
    <%= link_to "Include date-only events", admin_events_path(sort: params[:sort].presence, attachments: params[:attachments].presence) %>
  <% else %>
    <%= link_to "Only events with a time", admin_events_path(sort: params[:sort].presence, attachments: params[:attachments].presence, timed: "1") %>
  <% end %>
</div>

<table class="table table-sm table-striped table-hover">
  <thead>
    <tr>
      <th scope="col">#</th>
      <th scope="col">Name</th>
      <th scope="col">Date</th>
      <th scope="col" class="text-end">RSVPs</th>
      <th scope="col">Attachments</th>
      <th scope="col">Admin</th>
    </tr>
  </thead>
  <tbody>
    <% @events.each do |event| %>
      <tr>
        <th scope="row" class="text-nowrap"><%= link_to event.id, event %></th>
        <td><%= link_to event.title, event %></td>
        <td class="text-nowrap">
          <%= event.date %>
          <% if (time = event_time(event)) %>
            <small class="d-block text-muted"><%= time %></small>
          <% end %>
        </td>
        <td class="text-nowrap text-end"><code class="small"><%= event.rsvps_count %></code></td>
        <td class="text-nowrap">
          <% if event.attachments_count.to_i.positive? %>
            <%= pluralize(event.attachments_count.to_i, "file") %> ·
            <%= number_to_human_size(event.attachments_size.to_i) %>
          <% end %>
        </td>
        <td class="text-nowrap"><code class="small"><%= link_to event.admin_token.split('-').first, event_admin_path(event, event.admin_token), class: "text-body" %></code></td>
      </tr>
    <% end %>
  </tbody>
</table>

<%= paginate @events %>
